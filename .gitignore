# -----------------------------------------------------------------------------
# Operating-system files
# -----------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
.vs/
.vcpkg/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb



# Locally built macOS native plugin artifacts. Keep their Unity .meta files
# tracked so importer settings remain stable after rebuilding.
*.dylib
*.so
.tmp*
.utmp*

# Local datasets are generated or too large to version. Keep reproducible
# sync-test instructions while ignoring its generated image, mesh, and audio
# assets along with every other dataset.
/data/*
!/data/sync-test/
/data/sync-test/*
!/data/sync-test/generate.py
!/data/sync-test/README.md
/tmp/

# Unity packages generate editor-specific preferences beneath Assets even
# though they are not reproducible project inputs.
/Unity/Assets/CompositionLayers/UserSettings/
/Unity/Assets/XR/Temp/
/Unity/Assets/XR/UserSimulationSettings/
OpenVolumetricNative/tests/fixtures/*


/Unity/Assets/Plugins/OpenVolumetric/*