# -----------------------------------------------------------------------------
# Operating-system files
# -----------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# -----------------------------------------------------------------------------
# Native CMake and vcpkg output
# -----------------------------------------------------------------------------
OpenVolNative/build/
OpenVolNative/vcpkg_installed/
OpenVolNative/CMakeUserPresets.json
OpenVolNative/CMakeFiles/
OpenVolNative/CMakeCache.txt
OpenVolNative/cmake_install.cmake
OpenVolNative/compile_commands.json
OpenVolNative/.ninja_deps
OpenVolNative/.ninja_log
OpenVolNative/build.ninja

# Visual Studio native build output (scoped to the native project so Unity
# plugin directories such as Assets/Plugins/VolumetricVideo/x64 stay tracked).
OpenVolNative/Debug/
OpenVolNative/Release/
OpenVolNative/x64/
OpenVolNative/x86/
OpenVolNative/ARM/
OpenVolNative/ARM64/
OpenVolNative/*.dir/
OpenVolNative/*.log
OpenVolNative/*.tlog/
OpenVolNative/*.lastbuildstate

# Locally built macOS native plugin artifacts. Keep their Unity .meta files
# tracked so importer settings remain stable after rebuilding.
*.dylib
*.so
# -----------------------------------------------------------------------------
# Unity-generated directories
# -----------------------------------------------------------------------------
Unity/[Ll]ibrary/
Unity/[Tt]emp/
Unity/[Oo]bj/
Unity/[Ll]ogs/
Unity/[Uu]ser[Ss]ettings/
Unity/[Mm]emoryCaptures/
Unity/[Rr]ecordings/
Unity/[Bb]uild/
Unity/[Bb]uilds/

# Unity-generated IDE/project files
Unity/*.csproj
Unity/*.sln
Unity/*.suo
Unity/*.tmp
Unity/*.user
Unity/*.userprefs
Unity/*.pidb
Unity/*.booproj
Unity/*.svd
Unity/*.pdb
Unity/*.mdb
Unity/sysinfo.txt
Unity/Assets/StreamingAssets/*

# Unity crash reports
Unity/crashlytics-build.properties
Unity/[Cc]rash*/


.tmp*
.utmp*
