  "name": "volumetric-video-native-plugin",
  "version-string": "0.1.0",
  "description": "Native decoding dependencies for the Unity volumetric video plugin.",
  "builtin-baseline": "40f3c709db80acf154ac4b17a1f83c564ebd022e",
  "dependencies": [
    {
      "name": "ffmpeg",
      "version>=": "8.1.2#3",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample"
      ]
    },
    {
      "name": "pkgconf",
      "host": true
    }
  ]
}
